# ============================================================
#  متغیرهای محیطی ربات (نسخه ۲.۱.۰) — همین سه مورد، بیشتر لازم نیست
#  محل وارد کردن در Railway: سرویس → تب Variables → New Variable
# ============================================================

# (الزامی) توکن ربات — از @BotFather در تلگرام:
#   /mybots → انتخاب ربات → API Token  (یا /newbot برای ساخت ربات جدید)
BOT_TOKEN=1234567890:AA...توکن-جدید-از-BotFather...

# (الزامی) شناسه عددی تلگرامِ مالک — پنل مدیریت با همین ID باز می‌شود.
#   راه گرفتن: در تلگرام به @userinfobot پیام بدهید؛ عدد Id را عیناً وارد کنید.
#   (اخطار مهم: اگر اشتباه باشد پنل برای شما باز نمی‌شود؛ فقط عدد، بدون @)
OWNER_ID=0000000000

# (اختیاری) مسیر ذخیره‌سازی پایدار — پیش‌فرض /data است و روی Railway
#   باید مسیر اتصال Volume در تنظیمات سرویس هم دقیقاً /data باشد:
#   سرویس → Settings → Volumes → Mount path = /data
#   اگر مسیر Volume را چیز دیگری گذاشتید، همان را اینجا بنویسید:
# DATA_DIR=/data
